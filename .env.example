# =========================================================
# ClubMaster - Variables de entorno PRODUCTION READY
# Copia a .env (raiz) o Backend/.env y completa valores
# NUNCA subas el .env real a Git (esta en .gitignore)
# =========================================================
# Entorno: development | production
NODE_ENV=production
PORT=3000
# APP_URL = dominio publico del backend (usado para links de recuperacion y CORS fallback)
APP_URL=https://tu-app.onrender.com
# CORS_ORIGINS = lista blanca de dominios autorizados por CLIENTE (coma separada). OBLIGATORIO en production.
# Ejemplo SaaS: https://cliente1.clubmaster.app,https://cliente1.com
# On-Premise: https://192.168.1.10:3000
# NUNCA uses "*" en production
CORS_ORIGINS=https://tu-app.onrender.com,https://tu-frontend.vercel.app

# Secret para sesiones/JWT (min 32 chars aleatorios). Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_esto_por_un_hash_largo_64_chars_min

# ---- MySQL Opcion A: variables separadas (Railway/Render) ----
DB_HOST=tu-host-mysql
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_password_seguro
DB_NAME=discoteca_db
# Nubes como Railway/Aiven/Clever Cloud exigen SSL: true (o required).
# Si el proveedor entrega CA (p.ej. ca.pem): DB_SSL_CA=ruta/al/ca.pem
DB_SSL=false
# DB_POOL_LIMIT=10

# ---- Opcion B: URL unica (preferida en Railway/PlanetScale/Aiven) ----
# Tiene prioridad sobre la Opcion A. Si la URL trae ?ssl-mode=REQUIRED
# (Aiven, etc.) se detecta solo; tambien se auto-habilita SSL para
# hostnames railway/aiven/clever/planetscale/render/throughput.
# Descomenta si tu proveedor te da una DATABASE_URL
# DATABASE_URL=mysql://usuario:password@host:3306/discoteca_db?ssl-mode=REQUIRED
# DATABASE_URL_DEMO=mysql://usuario:password@host:3306/discoteca_db_demo

# Demo (opcional)
# DB_NAME_DEMO=discoteca_db_demo
# DEMO_MODE=false

# ---- Admin inicial para npm run setup:fresh ----
ADMIN_EMAIL=admin@clubmaster.com
ADMIN_TEMP_PASSWORD=ClubMaster2026*
ADMIN_NAME=Administrador

# ---- SMTP (opcional, recuperacion de contrasena) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu.correo@gmail.com
SMTP_PASS=tu_app_password
EMAIL_USER=tu.correo@gmail.com
EMAIL_PASS=tu_app_password
ADMIN_EMAIL_NOTIF=admin@tudominio.com

# ---- WHATSAPP (envío de reportes PDF/Excel por WhatsApp) ----
# Proveedor: mock | twilio | ultramsg | greenapi | baileys
WHATSAPP_PROVIDER=mock
WHATSAPP_ADMIN_PHONE=+573001234567
WHATSAPP_DEFAULT_CC=57
# Twilio (si WHATSAPP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=tu_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# UltraMsg (si WHATSAPP_PROVIDER=ultramsg)
# ULTRAMSG_INSTANCE=instance123
# ULTRAMSG_TOKEN=token_xxx
# GreenAPI (si WHATSAPP_PROVIDER=greenapi)
# GREENAPI_INSTANCE=1101000001
# GREENAPI_TOKEN=abc123
# Para adjuntos con Twilio se requiere URL pública:
# WHATSAPP_MEDIA_BASE_URL=https://tu-app.onrender.com/media
