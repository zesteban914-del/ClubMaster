# =========================================================
# ClubMaster - Variables de entorno (EJEMPLO, valores falsos)
# Copia a .env (raiz) o Backend/.env y completa valores.
# NUNCA subas el .env real a Git (esta en .gitignore).
#
# ORDEN DE LECTURA DE LA CONEXION A MYSQL (el primero gana):
#   1) DATABASE_URL
#   2) MYSQL_URL
#   3) DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
#      o MYSQLHOST / MYSQLPORT / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE
#
# IMPORTANTE (Railway): el servicio MySQL NO crea DATABASE_URL.
# Expone: MYSQL_URL (red interna), MYSQL_PUBLIC_URL (proxy publico,
# para correr scripts desde tu PC) y las variables sueltas
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE.
# La URL interna (*.railway.internal) solo funciona dentro de Railway.
# =========================================================

# Entorno: development | production
NODE_ENV=development
# PORT: Railway lo inyecta automaticamente (no lo definas alli).
# El valor por defecto 3000 aplica SOLO en desarrollo; en produccion
# PORT es obligatorio.
# PORT=3000

# APP_URL = dominio publico del BACKEND (Railway), sin "/" final.
# Lo usa el correo de reporte /api/jornada/{id}/reporte (solo existe en el
# backend; NO apuntes a Vercel: alli no hay /api y el link daria 404).
APP_URL=https://tu-backend.up.railway.app
# FRONTEND_URL = dominio publico del FRONTEND (Vercel), sin "/" final.
# Lo usa el correo de recuperacion /reiniciar-contrasena?token= (pagina que
# abre el usuario en el frontend). Sin definir, usa APP_URL como respaldo.
# FRONTEND_URL=https://tu-frontend.vercel.app

# CORS_ORIGINS = lista blanca del frontend, separada por comas, sin "/" final.
# OBLIGATORIO en produccion. NUNCA uses "*".
CORS_ORIGINS=https://club-master-git-main-esteban-90eb.vercel.app

# Cookies cruzadas (frontend Vercel + backend Railway en dominios distintos):
# NO hace falta definirlo. En produccion el servidor ya usa
# sameSite='none' + secure=true (requiere HTTPS, que Vercel/Railway cumplen);
# en desarrollo usa 'lax' + secure=false.
# COOKIE_SAMESITE=none

# Secretos: minimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En produccion el servidor NO arranca si faltan o son el valor de ejemplo.
SESSION_SECRET=cambia_esto_por_un_hash_largo_64_chars_min
JWT_SECRET=cambia_esto_por_un_jwt_largo_64_chars_min

# ---- MySQL: Opcion A (preferida en Railway) ----
# URL unica. En Railway la referencia del servicio backend es:
#   DATABASE_URL = ${{MySQL.MYSQL_URL}}      (red interna, backend)
# Desde tu PC (PowerShell) usa la URL publica del servicio MySQL:
#   $env:DATABASE_URL = "<valor de MYSQL_PUBLIC_URL>"
# Si la URL trae ?ssl-mode=REQUIRED se detecta solo; SSL tambien se
# auto-habilita para hosts railway/rlwy/aiven/planetscale/render/clever.
# DATABASE_URL=mysql://tu_usuario:tu_password_seguro@tu-host.nube.example.com:3306/discoteca_db?ssl-mode=REQUIRED

# ---- MySQL: Opcion B (variables sueltas) ----
# Se usan solo si no hay DATABASE_URL ni MYSQL_URL.
# En Railway tambien existen MYSQLHOST, MYSQLPORT, MYSQLUSER,
# MYSQLPASSWORD y MYSQLDATABASE (misma informacion, otros nombres).
DB_HOST=tu-host-mysql.nube.example.com
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_password_seguro
DB_NAME=discoteca_db
# Nubes como Railway/Aiven/Clever Cloud exigen SSL: true (o required).
# Si el proveedor entrega CA (p.ej. ca.pem): DB_SSL_CA=ruta/al/ca.pem
DB_SSL=false
# DB_POOL_LIMIT=10

# Demo (opcional)
# DATABASE_URL_DEMO=mysql://tu_usuario:tu_password@tu-host:3306/discoteca_db_demo
# DB_NAME_DEMO=discoteca_db_demo
# DEMO_MODE=false

# ---- Admin inicial para npm run setup:fresh (OBLIGATORIOS) ----
# ADMIN_TEMP_PASSWORD minimo 12 caracteres. La clave NO se imprime
# en pantalla; se guarda hasheada igual que en el login.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_TEMP_PASSWORD=TuClaveTemporal123
ADMIN_NAME=Administrador

# ---- Correo SMTP (recuperacion de contrasena + reporte de cierre) ----
# Variables canonicas que lee el codigo (Backend/config/mailer.js):
SMTP_HOST=smtp.tunube.example.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
# Alias legacy AUN leidos por el codigo (SMTP_USER/PASS tienen prioridad):
#EMAIL_USER=tu_usuario_smtp
#EMAIL_PASS=tu_password_smtp
# Destino fallback del reporte de cierre (Backend/routes/jornadas.js);
# ADMIN_EMAIL tambien se usa por npm run setup:fresh:
ADMIN_EMAIL=admin@tudominio.com

# ---- WHATSAPP (envio de reportes PDF/Excel por WhatsApp) ----
# Proveedor: mock | twilio | ultramsg | greenapi | baileys
WHATSAPP_PROVIDER=mock
WHATSAPP_ADMIN_PHONE=+573000000000
WHATSAPP_DEFAULT_CC=57
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=tu_token
# TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
# ULTRAMSG_INSTANCE=instance123
# ULTRAMSG_TOKEN=token_xxx
# GREENAPI_INSTANCE=1101000001
# GREENAPI_TOKEN=abc123
# WHATSAPP_MEDIA_BASE_URL=https://tu-backend.up.railway.app/media

# =========================================================
# Vercel (frontend estatico) - configuracion de build
# Define en Vercel -> Settings -> Environment Variables
# para Production Y Preview (NO en .env local).
# Es la UNICA fuente de la URL del backend en el frontend.
# =========================================================
# Sin espacios ni "/" final. Ejemplo:
# https://club-master-git-main-esteban-90eb.vercel.app es el FRONTEND;
# aqui va el BACKEND de Railway:
VITE_API_URL=https://tu-backend.up.railway.app
