# =========================================================
# ClubMaster Backend - Variables de entorno PRODUCTION READY
# Copia a Backend/.env y completa valores. NO commitear el .env real.
# =========================================================
NODE_ENV=production
PORT=3000
SESSION_SECRET=cambia_esto_por_un_hash_largo_64_chars_min
APP_URL=https://tu-app.onrender.com
# CORS por cliente: lista blanca estricta en production (no "*")
CORS_ORIGINS=https://tu-app.onrender.com,https://tu-frontend.vercel.app

# ---- MySQL ----
# Opcion A: variables separadas (funciona con cualquier proveedor).
# Nota: los puertos de nubes (Railway/Aiven/Clever Cloud) suelen NO ser 3306.
DB_HOST=tu-host-mysql.nube.example.com
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_password_seguro
DB_NAME=discoteca_db
# Muchas nubes exigen SSL: pon true (o required/1). Si el proveedor entrega
# un certificado CA (p.ej. Aiven ca.pem), indica su ruta en DB_SSL_CA
# (tambien acepta el contenido PEM completo pegado como valor).
DB_SSL=false
# DB_SSL_CA=C:\ruta\al\ca.pem

# Opcion B (PREFERIDA en nube): URL unica que te da el proveedor.
# Tiene prioridad sobre la Opcion A. Railway/Aiven suelen incluir
# ?ssl-mode=REQUIRED al final; se detecta automaticamente (igual que
# hostnames railway/aiven/clever/planetscale/render).
# DATABASE_URL=mysql://usuario:password@host:3306/discoteca_db?ssl-mode=REQUIRED

# ---- IMPORTANTE (Vercel) ----
# Vercel es serverless: cada invocacion crea un pool nuevo de conexiones.
# MySQL no tiene driver serverless nativo, asi que usa un pool pequeno
# (DB_POOL_LIMIT=1) y DB_POOL_TIMEOUT bajo para evitar fugas de conexiones.
# Si tu proveedor de BD lo ofrece, prefiere keep-alives cortos.
# DB_POOL_LIMIT=1

ADMIN_EMAIL=admin@clubmaster.com
ADMIN_TEMP_PASSWORD=ClubMaster2026*

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu.correo@gmail.com
SMTP_PASS=tu_app_password
EMAIL_USER=tu.correo@gmail.com
EMAIL_PASS=tu_app_password
ADMIN_EMAIL_NOTIF=admin@tudominio.com

# Ruta al binario mysqldump para backups de cierre (opcional).
# Windows default: C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
# Linux/produccion: /usr/bin/mysqldump (o deja 'mysqldump' si esta en el PATH)
MYSQLDUMP_PATH=mysqldump

# ---- WHATSAPP (reportes PDF/Excel) ----
WHATSAPP_PROVIDER=mock
WHATSAPP_ADMIN_PHONE=+573001234567
WHATSAPP_DEFAULT_CC=57
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=tu_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# ULTRAMSG_INSTANCE=instance123
# ULTRAMSG_TOKEN=token_xxx
# GREENAPI_INSTANCE=1101000001
# GREENAPI_TOKEN=abc123
# WHATSAPP_MEDIA_BASE_URL=https://tu-app.onrender.com/media
