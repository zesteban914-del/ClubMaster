# =========================================================
# ClubMaster Backend - Variables de entorno (EJEMPLO, valores falsos)
# Copia a Backend/.env y completa valores. NO commitear el .env real.
# (Este archivo tiene prioridad sobre el .env de la raiz.)
#
# ORDEN DE LECTURA DE LA CONEXION A MYSQL (el primero gana):
#   1) DATABASE_URL
#   2) MYSQL_URL
#   3) DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
#      o MYSQLHOST / MYSQLPORT / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE
#
# IMPORTANTE (Railway): el servicio MySQL NO crea DATABASE_URL.
# Expone MYSQL_URL (interna), MYSQL_PUBLIC_URL (publica, para tu PC) y
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE.
# En el servicio backend de Railway usa:
#   DATABASE_URL = ${{MySQL.MYSQL_URL}}
# =========================================================
NODE_ENV=development
# PORT: Railway lo inyecta; el default 3000 es SOLO para desarrollo.
# PORT=3000
SESSION_SECRET=cambia_esto_por_un_hash_largo_64_chars_min
JWT_SECRET=cambia_esto_por_un_jwt_largo_64_chars_min
# APP_URL = dominio publico del BACKEND (Railway), sin "/" final.
# Lo usa el correo de reporte /api/jornada/{id}/reporte (solo existe en el
# backend; NO apuntes a Vercel: alli no hay /api y el link daria 404).
APP_URL=https://tu-backend.up.railway.app
# FRONTEND_URL = dominio publico del FRONTEND (Vercel), sin "/" final.
# Lo usa el correo de recuperacion /reiniciar-contrasena?token= (pagina que
# abre el usuario en el frontend). Sin definir, usa APP_URL como respaldo.
# FRONTEND_URL=https://tu-frontend.vercel.app
# CORS: lista blanca estricta en production (no "*", sin "/" final)
CORS_ORIGINS=https://club-master-git-main-esteban-90eb.vercel.app
# Frontend en Vercel y backend en Railway = dominios distintos.
# NO hace falta definirlo: en produccion el servidor ya usa
# sameSite='none' + secure=true, y en desarrollo 'lax' + secure=false.
# Descomentalo solo para forzar un valor (p. ej. 'lax' en produccion
# si el frontend se sirve desde el mismo dominio).
# COOKIE_SAMESITE=none

# ---- MySQL ----
# Opcion A: URL unica (PREFERIDA). Railway NO genera DATABASE_URL;
# crea MYSQL_URL / MYSQL_PUBLIC_URL. Referencia en Railway:
#   DATABASE_URL = ${{MySQL.MYSQL_URL}}
# Desde tu PC (PowerShell): $env:DATABASE_URL = "<MYSQL_PUBLIC_URL>"
# Los puertos de nubes (Railway/Aiven/Clever) suelen NO ser 3306.
# DATABASE_URL=mysql://tu_usuario:tu_password_seguro@tu-host.nube.example.com:3306/discoteca_db?ssl-mode=REQUIRED

# Opcion B: variables sueltas (si no hay URL). Tambien existen
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE.
DB_HOST=tu-host-mysql.nube.example.com
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_password_seguro
DB_NAME=discoteca_db
# Muchas nubes exigen SSL: pon true (o required/1). Si el proveedor entrega
# un certificado CA (p.ej. Aiven ca.pem), indica su ruta en DB_SSL_CA
# (tambien acepta el contenido PEM completo pegado como valor).
DB_SSL=false
# DB_SSL_CA=C:\ruta\al\ca.pem

# ---- IMPORTANTE (solo si el frontend tambien esta en Vercel) ----
# Vercel es serverless y no usa estas variables; aqui aplica el pool
# normal de Railway. Para entornos serverless usa pool pequeno:
# DB_POOL_LIMIT=1

# ---- Admin inicial para npm run setup:fresh (OBLIGATORIOS) ----
# ADMIN_TEMP_PASSWORD minimo 12 caracteres; nunca se imprime en pantalla.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_TEMP_PASSWORD=TuClaveTemporal123

# ---- Correo SMTP (recuperacion de contrasena + reporte de cierre) ----
# Variables canonicas que lee el codigo (config/mailer.js):
SMTP_HOST=smtp.tunube.example.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
# Alias legacy AUN leidos por el codigo (SMTP_USER/PASS tienen prioridad):
#EMAIL_USER=tu_usuario_smtp
#EMAIL_PASS=tu_password_smtp
# Destino fallback del reporte de cierre (routes/jornadas.js): usa la
# variable ADMIN_EMAIL de arriba (mismo valor que para setup:fresh).

# Ruta al binario mysqldump para backups de cierre (opcional).
# Windows default: C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
# Linux/produccion: /usr/bin/mysqldump (o deja 'mysqldump' si esta en el PATH)
MYSQLDUMP_PATH=mysqldump

# ---- WHATSAPP (reportes PDF/Excel) ----
WHATSAPP_PROVIDER=mock
WHATSAPP_ADMIN_PHONE=+573000000000
WHATSAPP_DEFAULT_CC=57
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=tu_token
# TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
# ULTRAMSG_INSTANCE=instance123
# ULTRAMSG_TOKEN=token_xxx
# GREENAPI_INSTANCE=1101000001
# GREENAPI_TOKEN=abc123
# WHATSAPP_MEDIA_BASE_URL=https://tu-backend.up.railway.app/media
