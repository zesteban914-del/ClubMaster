# Valores de EJEMPLO — no son credenciales reales. No suba archivos .env al repo.
# Para el servicio en Railway: pegue estas claves como Variables del servicio (no como archivos).
# Para restaurar en local: copie este archivo a .env.restore y complete los valores.

# --- MySQL origen (producción, red interna Railway) ---
MYSQLHOST=mysql.railway.internal
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=CAMBIAR_ESTA_CLAVE
MYSQLDATABASE=railway

# --- Backblaze B2 (API compatible con S3) ---
BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKUP_S3_BUCKET=coloque-aqui-su-bucket
BACKUP_S3_ACCESS_KEY=coloque-aqui-su-keyID
BACKUP_S3_SECRET_KEY=coloque-aqui-su-applicationKey
# BACKUP_S3_REGION se deriva del endpoint si se omite (ej: us-west-004)
#BACKUP_S3_REGION=us-west-004
# Prefijo opcional dentro del bucket (ej: clubmaster/). Vacío = raíz.
#BACKUP_PREFIX=
# Umbrales opcionales
#MIN_DUMP_BYTES=10240
#RETENTION_DAILY=7
#RETENTION_WEEKLY=4

# --- Solo para restore.sh (base DESTINO de prueba, nunca producción) ---
#RESTORE_MYSQLHOST=
#RESTORE_MYSQLPORT=3306
#RESTORE_MYSQLUSER=root
#RESTORE_MYSQLPASSWORD=CAMBIAR_ESTA_CLAVE
#RESTORE_MYSQLDATABASE=clubmaster_restore_prueba
